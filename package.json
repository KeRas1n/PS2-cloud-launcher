{
  "name": "ps2-cloud-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first PS2 library with PCSX2 and Dropbox",
  "author": "PS2 Cloud Launcher contributors",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview --host 127.0.0.1",
    "test:smoke": "node scripts/smoke.cjs",
    "format": "prettier --write src electron shared tests scripts *.json *.ts *.html .github/workflows/*.yml",
    "test:integration": "node scripts/integration.cjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.ps2cloud.launcher",
    "productName": "PS2 Cloud Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "PS2 Cloud Launcher contributors",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
